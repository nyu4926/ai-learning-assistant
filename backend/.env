# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string-in-production

# 数据库（留空则默认用 backend/instance/dev.db）
# 生产环境换 PostgreSQL：postgresql://user:pass@localhost/dbname
DATABASE_URL=

# LLM API（DeepSeek — OpenAI 兼容接口）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-7d64964e496f4063befbe9bfe4431b13
LLM_MODEL=deepseek-chat

# 文件上传
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# 分块参数（RAG 用）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 向量数据库
CHROMA_PERSIST_DIR=
EMBEDDING_MODEL_PATH=D:\pycharm\test\上课资料0430\个人学习助手V2.0版本\ai-learning-assistant\embedding_model\all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.3
